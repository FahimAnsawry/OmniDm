{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniDM Setup",
  "mainBinaryName": "OmniDM-Setup",
  "identifier": "io.github.fahimansawry.omnidm.setup",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../app/src-tauri/icons/icon.ico"]
  }
}
